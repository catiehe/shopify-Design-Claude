<header class="site-header">
  <div class="page-width header-row">
    <button class="menu-toggle" type="button" aria-label="Menu" data-menu-toggle>☰</button>
    <a class="logo" href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name | escape }}</a>
    <nav class="main-nav" data-menu>
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
    </nav>
    <div class="header-actions"><a href="{{ routes.search_url }}" aria-label="Search">⌕</a><a href="{{ routes.account_url }}" aria-label="Account">♙</a><a href="{{ routes.cart_url }}" aria-label="Cart">Bag <span data-cart-count>{{ cart.item_count }}</span></a></div>
  </div>
  <nav class="prototype-tabs" aria-label="Prototype pages"><a href="{{ routes.root_url }}" class="{% if request.page_type == 'index' or request.page_type == 'collection' %}is-active{% endif %}">Collection page</a><a href="{% if section.settings.demo_product != blank %}{{ section.settings.demo_product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="{% if request.page_type == 'product' %}is-active{% endif %}">Product detail</a><a href="{{ section.settings.faq_page.url | default: '/pages/faq' }}" class="{% if page.handle == 'faq' %}is-active{% endif %}">FAQ + Help</a></nav>
</header>
{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},{"type":"product","id":"demo_product","label":"Product detail tab product"},{"type":"page","id":"faq_page","label":"FAQ page"}]}{% endschema %}
