<section class="home-hero"{% if section.settings.image != blank %} style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}')"{% else %} style="background-image:linear-gradient(90deg,rgba(0,0,0,.16),rgba(0,0,0,.02)),url('https://images.unsplash.com/photo-1618244972963-dbee1a7edc95?w=2400&auto=format&fit=crop')"{% endif %}><div class="home-hero__content"><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p>{% if section.settings.link_label != blank %}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>{% endif %}</div></section>
{% schema %}{"name":"Home hero","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"heading","label":"Heading","default":"Just dropped: new cotton jersey & cotton rib"},{"type":"text","id":"text","label":"Text","default":"Discover fresh shades, returning favorites, and more new arrivals"},{"type":"text","id":"link_label","label":"Button label","default":"Shop now"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"Home hero"}]}{% endschema %}
