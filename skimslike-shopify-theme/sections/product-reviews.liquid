<section class="reviews page-width"><h2>Reviews</h2><div class="reviews-summary"><div><strong>4.8</strong><span>★★★★★</span><p>Based on 2,830 reviews</p></div><div class="fit-line"><i></i><span>Runs Small</span><span>True to Size</span><span>Runs Large</span></div><button class="outline-button" type="button">Filters</button></div>{% for block in section.blocks %}<article class="review" {{ block.shopify_attributes }}><div><strong>{{ block.settings.initials }}</strong><p>Verified Buyer</p></div><div><span>★★★★★</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></div><time>{{ block.settings.when }}</time></article>{% endfor %}</section>{% schema %}{"name":"Product reviews","blocks":[{"type":"review","name":"Review","settings":[{"type":"text","id":"initials","label":"Initials","default":"J.C"},{"type":"text","id":"title","label":"Title","default":"Comfy"},{"type":"text","id":"body","label":"Review","default":"Easily the most comfortable thong that I have ever worn."},{"type":"text","id":"when","label":"When","default":"2 months ago"}]}],"presets":[{"name":"Product reviews","blocks":[{"type":"review"},{"type":"review","settings":{"initials":"M.R","title":"So comfy!","body":"Fits perfectly true to size. The fabric is incredibly soft and smooth.","when":"3 months ago"}},{"type":"review","settings":{"initials":"A.T","title":"Great fit","body":"Love the seamless design. Barely noticeable under clothing.","when":"1 month ago"}}]}]}{% endschema %}
