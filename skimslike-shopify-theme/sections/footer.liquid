<footer class="site-footer">
  <div class="footer-statement">{{ section.settings.statement }}</div>
  <div class="page-width footer-grid">
    <nav aria-label="{{ section.settings.help_heading | escape }}">
      <h3>{{ section.settings.help_heading }}</h3>
      {% for link in section.settings.help_menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% else %}
        <a href="/pages/returns">Return Center</a><a href="/pages/returns">Order & Return Tracking</a><a href="/pages/size-guide">Size Guides</a><a href="/pages/ordering">Ordering</a><a href="/pages/shipping">Shipping</a><a href="/pages/faq">FAQs</a><a href="/pages/contact">Contact Us</a>
      {% endfor %}
    </nav>
    <div class="footer-newsletter">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {% form 'customer', id: 'footer-email-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
        <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="your email" autocomplete="email" required>
        <button type="submit" aria-label="Subscribe">→</button>
        {% if form.posted_successfully? %}<p class="footer-message">Thanks for subscribing.</p>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
      <small>{{ section.settings.legal_text }}</small>
    </div>
    <nav aria-label="{{ section.settings.more_heading | escape }}">
      <h3>{{ section.settings.more_heading }}</h3>
      {% for link in section.settings.more_menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% else %}
        <a href="/pages/about">About</a><a href="/pages/rewards">Rewards</a><a href="/products/gift-card">E-Gift Card</a><a href="/pages/stockists">Store Locator</a><a href="/blogs/news">Blog</a>
      {% endfor %}
    </nav>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "statement", "label": "Brand statement", "default": "A solutions-oriented brand creating the next generation of underwear, clothing, and shapewear." },
    { "type": "text", "id": "help_heading", "label": "Help heading", "default": "Help" },
    { "type": "link_list", "id": "help_menu", "label": "Help menu" },
    { "type": "text", "id": "heading", "label": "Newsletter heading", "default": "Stay in the know" },
    { "type": "text", "id": "text", "label": "Newsletter text", "default": "Be the first to discover new drops, special offers, and more." },
    { "type": "richtext", "id": "legal_text", "label": "Newsletter legal text", "default": "<p>By subscribing, you agree to receive marketing emails.</p>" },
    { "type": "text", "id": "more_heading", "label": "More heading", "default": "More" },
    { "type": "link_list", "id": "more_menu", "label": "More menu" }
  ]
}
{% endschema %}
