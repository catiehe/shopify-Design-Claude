<section class="skim-faq">
  {% if section.settings.image != blank %}
    <div class="skim-faq__hero">{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1800', sizes: '100vw', alt: section.settings.image.alt }}</div>
  {% endif %}
  <div class="skim-faq__layout page-pad">
    <aside class="skim-faq__aside">
      <nav class="skim-breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><span>{{ page.title | escape }}</span></nav>
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      {% if section.settings.menu != blank %}<nav class="skim-faq__menu" aria-label="{{ 'faq.categories' | t }}">{% for link in section.settings.menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endfor %}</nav>{% endif %}
    </aside>
    <div class="skim-faq__content">
      <h2>{{ section.settings.subheading | escape }}</h2>
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Returns & exchanges" },
    { "type": "link_list", "id": "menu", "label": "Category menu" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can I exchange my item?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add the answer here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
