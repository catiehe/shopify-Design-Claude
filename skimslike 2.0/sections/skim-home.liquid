{% assign featured_collection = section.settings.collection %}
{% if featured_collection == blank %}{% assign featured_collection = collections.all %}{% endif %}
<section class="skim-collection skim-home-collection">
  <header class="skim-collection__header page-pad">
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="skim-home-collection__description">{{ section.settings.description | escape }}</p>
    <nav class="skim-breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span>{{ section.settings.heading | escape }}</span></nav>
  </header>
  <div class="skim-filters skim-home-collection__filters page-pad" aria-label="Collection filters">
    <span>Sort</span><span>Gender</span><span>Size</span><span>Band</span><span>Cup</span><span>Type</span><span>Color</span><span>Collection</span><span>Material</span><span>Sleeve Length</span><span>Inseam</span>
  </div>
  <div class="skim-grid page-pad">
    {% for product in featured_collection.products limit: section.settings.product_limit %}
      {% render 'product-card', product: product, show_vendor: true, show_quick_add: true %}
    {% else %}
      {% for item in (1..8) %}
        <article class="skim-card">
          <div class="skim-card__media">{{ 'product-' | append: forloop.index | placeholder_svg_tag: 'skim-card__placeholder' }}{% if forloop.index == 1 or forloop.index == 2 %}<span class="skim-card__badge">{% if forloop.index == 1 %}Best Seller{% else %}New{% endif %}</span>{% endif %}</div>
          <div class="skim-card__details"><p class="skim-eyebrow">Fits Everybody</p><p class="skim-card__title">Essential Style {{ forloop.index }}</p><p class="skim-card__price">Add products in Shopify</p></div>
        </article>
      {% endfor %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Skimslike collection home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "text", "id": "description", "label": "Description", "default": "The must-haves all your friends have been telling you about" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 4, "max": 24, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Skimslike collection home" }]
}
{% endschema %}
