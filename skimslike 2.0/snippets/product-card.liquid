{% doc %}
  Renders a product card for collection and recommendation grids.

  @param {product} product - Product to display.
  @param {boolean} [show_vendor] - Show the product vendor above the title.
  @param {boolean} [show_quick_add] - Show quick add for single-variant products.

  @example
  {% render 'product-card', product: product, show_vendor: true, show_quick_add: true %}
{% enddoc %}

<article class="skim-card">
  <a class="skim-card__media" href="{{ product.url }}">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 480, 720, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'skim-card__placeholder' }}
    {% endif %}
    {% unless product.available %}<span class="skim-card__badge">{{ 'products.sold_out' | t }}</span>{% endunless %}
    {% if product.compare_at_price > product.price %}<span class="skim-card__badge">{{ 'products.sale' | t }}</span>{% endif %}
  </a>
  <div class="skim-card__details">
    {% if show_vendor %}<p class="skim-eyebrow">{{ product.vendor | escape }}</p>{% endif %}
    <a class="skim-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
    <p class="skim-card__price">{{ product.price | money }}{% if product.price_varies %} {{ 'products.and_up' | t }}{% endif %}</p>
  </div>
  {% if show_quick_add and product.has_only_default_variant and product.available %}
    {% form 'product', product, class: 'skim-card__quick-add' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit">{{ 'products.quick_add' | t }}</button>
    {% endform %}
  {% endif %}
</article>
