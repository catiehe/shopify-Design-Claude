{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'ProductForm-' | append: section.id %}
<section class="pdp" data-product-section>
  <div class="pdp__media">
    {% if product.media.size > 0 %}
      {% for media in product.media %}
        <div class="pdp__media-item{% if forloop.first %} is-active{% endif %}" data-product-media>
          {% if media.media_type == 'image' %}
            {{ media.preview_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 55vw, 100vw', alt: media.alt | default: product.title }}
          {% else %}
            {{ media | media_tag }}
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <div class="pdp__media-item is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {% endif %}
    <button class="pdp__zoom" type="button" aria-label="Zoom image">+</button>
    <button class="pdp__wishlist" type="button" aria-label="Add to wishlist">♡</button>
    <span class="pdp__model-sizing">↕ Model sizing</span>
  </div>
  <div class="pdp__details">
    <div class="pdp__details-inner">
      <p class="product__vendor">{{ product.vendor | default: product.type }}</p>
      <h1 class="product__title">{{ product.title }}</h1>
      <p class="price" data-product-price>{{ current_variant.price | money }}</p>
      {% if section.settings.bundle_text != blank %}<p class="pdp__bundle">{{ section.settings.bundle_text }}</p>{% endif %}
      {% if current_variant.compare_at_price > current_variant.price %}<p class="compare-price">{{ current_variant.compare_at_price | money }}</p>{% endif %}
      <div class="pdp__rewards"><span aria-hidden="true">↘</span><div>{{ section.settings.rewards_text }}{% if section.settings.rewards_link_label != blank %}<br><a href="{{ section.settings.rewards_link }}">{{ section.settings.rewards_link_label }}</a>{% endif %}</div></div>
      {% form 'product', product, id: product_form_id %}
        {% for option in product.options_with_values %}
          {% assign option_name = option.name | downcase %}
          <fieldset class="variant-options{% if option_name contains 'color' or option_name contains 'colour' %} variant-options--swatches{% endif %}">
            <legend>
              {% if option_name contains 'color' or option_name contains 'colour' %}{{ section.settings.shades_label }}{% else %}{{ option.name }}{% endif %}
              <strong data-selected-option data-option-label-position="{{ option.position }}">{{ option.selected_value }}</strong>
              {% if option_name contains 'size' and section.settings.size_guide_label != blank %}<a href="{{ section.settings.size_guide_link }}">{{ section.settings.size_guide_label }}</a>{% endif %}
            </legend>
            <div class="variant-options__values">
              {% for option_value in option.values %}
                <input id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ option_value | escape }}" data-option-position="{{ option.position }}"{% if option_value.selected %} checked{% endif %}{% unless option_value.available %} disabled{% endunless %}>
                <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"{% if option_name contains 'color' or option_name contains 'colour' %} class="variant-swatch"{% if option_value.swatch.color != blank %} style="--swatch-color:{{ option_value.swatch.color }}"{% endif %}{% endif %}><span class="{% if option_name contains 'color' or option_name contains 'colour' %}visually-hidden{% endif %}">{{ option_value }}</span></label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <button class="pdp__add button button--dark" type="submit"{% unless current_variant.available %} disabled{% endunless %} data-add-to-cart>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</button>
      {% endform %}
      {% if product.description != blank %}<details><summary>Description <span>+</span></summary><div class="rte">{{ product.description }}</div></details>{% endif %}
      {% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading }} <span>+</span></summary><div class="rte">{{ block.settings.text }}</div></details>{% endfor %}
    </div>
  </div>
  <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "text", "id": "bundle_text", "label": "Bundle offer", "default": "or 3 for $39" },
    { "type": "richtext", "id": "rewards_text", "label": "Rewards message", "default": "<p>Returns are free for rewards members</p>" },
    { "type": "text", "id": "rewards_link_label", "label": "Rewards link label", "default": "Click here to join today." },
    { "type": "url", "id": "rewards_link", "label": "Rewards link" },
    { "type": "text", "id": "shades_label", "label": "Color group label", "default": "Classic shades" },
    { "type": "text", "id": "size_guide_label", "label": "Size guide label", "default": "Size guide" },
    { "type": "url", "id": "size_guide_link", "label": "Size guide link" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your policy here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Main product" }]
}
{% endschema %}
