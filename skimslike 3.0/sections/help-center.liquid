<main class="help-center">
  <section class="help-hero"><p>Customer care</p><h1>How can we help?</h1><form action="{{ routes.search_url }}"><input type="hidden" name="type" value="page"><input name="q" type="search" aria-label="Search help" placeholder="Search orders, returns, care and more"><button aria-label="Search">→</button></form></section>
  <section class="help-links page-width"><a href="#orders">Order Tracking <i>→</i></a><a href="#shipping">Shipping <i>→</i></a><a href="#returns">Returns &amp; Exchanges <i>→</i></a><a href="#sizing">Size Guide <i>→</i></a><a href="#care">Product &amp; Fabric Care <i>→</i></a><a href="#contact">Contact Us <i>→</i></a></section>
  <section class="help-faq page-width"><header><p>Frequently asked questions</p><h2>Answers, made simple.</h2></header><div class="faq-items"><details id="orders"><summary>How do I track my order?<span>+</span></summary><p>Once your order ships, we will email you a tracking link. You can also view its status from your account.</p></details><details id="returns"><summary>What is your return policy?<span>+</span></summary><p>Eligible unworn items may be returned in their original condition using the link in your order confirmation.</p></details><details id="care"><summary>How should I wash Merino Wool?<span>+</span></summary><p>Wash cold on a gentle wool cycle with wool-safe detergent. Reshape while damp and dry flat.</p></details><details><summary>Does Merino Wool shrink?<span>+</span></summary><p>High heat and agitation can shrink natural fibres. Follow the care label and avoid tumble drying.</p></details><details id="sizing"><summary>How do I choose my size?<span>+</span></summary><p>Use our size guide and compare the measurements with a similar garment you already own.</p></details><details id="shipping"><summary>Do you ship internationally?<span>+</span></summary><p>Available destinations, delivery estimates and charges are displayed during checkout.</p></details></div></section>
  <section class="help-contact" id="contact"><p>Still need help?</p><h2>We’re here for you.</h2><p>Our customer care team typically replies within 1–2 business days.</p><a href="mailto:hello@mellowool.com">Contact Us</a></section>
</main>
{% style %}
#shopify-section-{{ section.id }} .help-hero{background:#f3f1ee;padding:100px 24px;text-align:center}#shopify-section-{{ section.id }} .help-hero>p,#shopify-section-{{ section.id }} .help-faq header>p,#shopify-section-{{ section.id }} .help-contact>p:first-child{font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase}#shopify-section-{{ section.id }} .help-hero h1{font-size:clamp(58px,7vw,105px);margin:18px 0 45px}#shopify-section-{{ section.id }} .help-hero form{display:flex;margin:auto;max-width:680px}#shopify-section-{{ section.id }} .help-hero input{background:#fff;border:1px solid #bbb;font-size:15px;padding:20px 24px}#shopify-section-{{ section.id }} .help-hero button{background:#1a1a1a;border:0;color:#fff;font-size:22px;margin:0;width:72px}#shopify-section-{{ section.id }} .help-links{display:grid;grid-template-columns:repeat(3,1fr);padding-block:100px}#shopify-section-{{ section.id }} .help-links a{border-bottom:1px solid var(--line);display:flex;font-size:13px;font-weight:600;justify-content:space-between;letter-spacing:.08em;padding:28px 20px;text-transform:uppercase}#shopify-section-{{ section.id }} .help-links a:nth-child(odd){border-right:1px solid var(--line)}#shopify-section-{{ section.id }} .help-links i{font-size:20px;font-style:normal}#shopify-section-{{ section.id }} .help-faq{display:grid;gap:80px;grid-template-columns:.75fr 1.25fr;padding-bottom:120px}#shopify-section-{{ section.id }} .help-faq h2{font-size:clamp(42px,5vw,70px);line-height:.95;margin:20px 0}#shopify-section-{{ section.id }} .faq-items{border-top:1px solid var(--line)}#shopify-section-{{ section.id }} .faq-items details{border-bottom:1px solid var(--line);padding:0}#shopify-section-{{ section.id }} .faq-items summary{align-items:center;display:flex;font-size:14px;justify-content:space-between;padding:24px 0}#shopify-section-{{ section.id }} .faq-items summary span{font-size:22px}#shopify-section-{{ section.id }} .faq-items details p{color:#555;line-height:1.7;margin:0;padding:0 40px 26px 0}#shopify-section-{{ section.id }} .help-contact{background:#222;color:#fff;padding:100px 24px;text-align:center}#shopify-section-{{ section.id }} .help-contact h2{font-size:clamp(48px,6vw,84px);margin:20px 0}#shopify-section-{{ section.id }} .help-contact a{background:#fff;color:#1a1a1a;display:inline-block;font-size:11px;font-weight:600;letter-spacing:.16em;margin-top:25px;padding:18px 38px;text-transform:uppercase}@media(max-width:800px){#shopify-section-{{ section.id }} .help-links{grid-template-columns:1fr;padding:50px 20px}#shopify-section-{{ section.id }} .help-faq{grid-template-columns:1fr;gap:35px;padding:70px 20px}}
{% endstyle %}
{% schema %}{"name":"Help center","settings":[],"presets":[{"name":"Help center"}]}{% endschema %}
