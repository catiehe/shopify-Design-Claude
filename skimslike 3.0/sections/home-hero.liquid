<section class="home-hero"{% if section.settings.image != blank %} style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}')"{% else %} style="background-image:linear-gradient(90deg,rgba(0,0,0,.16),rgba(0,0,0,.02)),url('https://images.unsplash.com/photo-1618244972963-dbee1a7edc95?w=2400&auto=format&fit=crop')"{% endif %}>
  <div class="home-hero__content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.link_label != blank %}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>{% endif %}
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} .home-hero{min-height:100vh;padding:0 28px 62px}
  #shopify-section-{{ section.id }} .home-hero:before{background:linear-gradient(90deg,rgba(0,0,0,.22),transparent 62%)}
  #shopify-section-{{ section.id }} .home-hero__content{max-width:850px}
  #shopify-section-{{ section.id }} .home-hero h1{font-family:var(--font-heading-family);font-size:clamp(46px,4.1vw,68px);font-weight:700;letter-spacing:.025em;line-height:1.04;margin:0 0 14px;text-transform:uppercase}
  #shopify-section-{{ section.id }} .home-hero p{font-family:var(--font-body-family);font-size:20px;font-weight:400;letter-spacing:0;line-height:1.4;margin:0 0 34px}
  #shopify-section-{{ section.id }} .home-hero a{font-family:var(--font-body-family);font-size:16px;font-weight:600;letter-spacing:0;text-decoration:underline;text-underline-offset:6px}
  @media(max-width:900px){#shopify-section-{{ section.id }} .home-hero{min-height:680px;padding:0 20px 45px}#shopify-section-{{ section.id }} .home-hero h1{font-size:44px}#shopify-section-{{ section.id }} .home-hero p{font-size:16px;margin-bottom:26px}}
{% endstyle %}
{% schema %}{"name":"Home hero","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"heading","label":"Heading","default":"Just dropped: Merino Wool daily essentials"},{"type":"text","id":"text","label":"Text","default":"Discover fresh shades, returning favorites, and more new arrivals"},{"type":"text","id":"link_label","label":"Button label","default":"Shop now"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"Home hero"}]}{% endschema %}
