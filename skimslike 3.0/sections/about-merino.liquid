<main class="merino-page">
  <section class="merino-hero"><p class="kicker">The Mello Wool Material Guide</p><h1>Better by nature.</h1><p>{{ section.settings.intro }}</p><div class="page-actions"><a href="/collections/womens">Shop Women’s</a><a href="/collections/mens">Shop Men’s</a></div></section>
  <section class="merino-benefits page-width"><header><p class="kicker">Why Merino</p><h2>One fibre.<br>More possibilities.</h2></header><div class="benefit-grid"><article><span>01</span><h3>Breathable</h3><p>Fine Merino fibres naturally manage heat and moisture to help your body stay comfortable.</p></article><article><span>02</span><h3>Temperature regulating</h3><p>Warm when it is cool and breathable when it is warm—made for changing days and seasons.</p></article><article><span>03</span><h3>Odour resistant</h3><p>Merino absorbs moisture vapour before odours form, helping clothes feel fresher for longer.</p></article><article><span>04</span><h3>Soft on skin</h3><p>Extra-fine fibres bend against the skin for a smooth, lightweight feel without bulk.</p></article></div></section>
  <section class="merino-story"><div><p class="kicker">Fabric led</p><h2>Made for every day, considered for the long run.</h2></div><div><p>We begin with the fabric. Our Merino Wool essentials are designed to be worn often, layered easily and kept in rotation across seasons.</p><p>Naturally renewable and remarkably versatile, Merino lets us create fewer, better pieces that work harder in everyday life.</p></div></section>
  <section class="merino-care page-width"><p class="kicker">Care guide</p><h2>Wear more.<br>Wash less.</h2><div class="care-steps"><p><b>01</b>Air between wears</p><p><b>02</b>Cold gentle wash</p><p><b>03</b>Use wool detergent</p><p><b>04</b>Reshape and dry flat</p></div><a href="/pages/faq">View Fabric &amp; Care Guide →</a></section>
  <section class="merino-shop"><p class="kicker">The everyday collection</p><h2>Discover Merino essentials.</h2><div class="page-actions"><a href="/collections/womens">Shop Women’s</a><a href="/collections/mens">Shop Men’s</a></div></section>
</main>
{% style %}
#shopify-section-{{ section.id }} .kicker{font-size:11px;font-weight:600;letter-spacing:.2em;margin:0 0 24px;text-transform:uppercase}#shopify-section-{{ section.id }} .merino-hero{align-items:center;background:#f1efeb;display:flex;flex-direction:column;justify-content:center;min-height:620px;padding:80px 24px;text-align:center}#shopify-section-{{ section.id }} .merino-hero h1{font-size:clamp(70px,9vw,138px);letter-spacing:-.035em;line-height:.85;margin:0}#shopify-section-{{ section.id }} .merino-hero>p:not(.kicker){font-size:20px;font-weight:300;line-height:1.6;margin:38px auto;max-width:680px}#shopify-section-{{ section.id }} .page-actions{display:flex;gap:10px;justify-content:center}#shopify-section-{{ section.id }} .page-actions a{background:#1a1a1a;color:#fff;font-size:11px;font-weight:600;letter-spacing:.16em;min-width:170px;padding:18px 24px;text-transform:uppercase}#shopify-section-{{ section.id }} .merino-benefits{display:grid;gap:80px;grid-template-columns:.8fr 1.2fr;padding-bottom:120px;padding-top:120px}#shopify-section-{{ section.id }} h2{font-size:clamp(44px,5vw,76px);letter-spacing:-.025em;line-height:.95;margin:0}#shopify-section-{{ section.id }} .benefit-grid{display:grid;grid-template-columns:1fr 1fr}#shopify-section-{{ section.id }} .benefit-grid article{border-left:1px solid var(--line);border-top:1px solid var(--line);padding:28px 34px 42px}#shopify-section-{{ section.id }} .benefit-grid span{color:#888;font-size:11px}#shopify-section-{{ section.id }} .benefit-grid h3{font-family:var(--font-body-family);font-size:18px;margin:38px 0 14px}#shopify-section-{{ section.id }} .benefit-grid p{color:#555;line-height:1.7}#shopify-section-{{ section.id }} .merino-story{background:#252321;color:#fff;display:grid;gap:100px;grid-template-columns:1fr 1fr;padding:120px max(40px,8vw)}#shopify-section-{{ section.id }} .merino-story p{font-size:18px;font-weight:300;line-height:1.7}#shopify-section-{{ section.id }} .merino-care{padding-bottom:130px;padding-top:130px;text-align:center}#shopify-section-{{ section.id }} .care-steps{border-block:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);margin:60px 0 35px;text-align:left}#shopify-section-{{ section.id }} .care-steps p{border-right:1px solid var(--line);padding:28px}#shopify-section-{{ section.id }} .care-steps b{display:block;font-size:10px;margin-bottom:24px}#shopify-section-{{ section.id }} .merino-shop{background:#e2d9ce;padding:110px 24px;text-align:center}#shopify-section-{{ section.id }} .merino-shop h2{margin-bottom:45px}@media(max-width:800px){#shopify-section-{{ section.id }} .merino-benefits,#shopify-section-{{ section.id }} .merino-story{grid-template-columns:1fr;gap:50px;padding:70px 20px}#shopify-section-{{ section.id }} .benefit-grid{grid-template-columns:1fr}#shopify-section-{{ section.id }} .merino-care{padding:75px 20px}#shopify-section-{{ section.id }} .care-steps{grid-template-columns:1fr 1fr}#shopify-section-{{ section.id }} .page-actions{flex-direction:column}}
{% endstyle %}
{% schema %}{"name":"About Merino","settings":[{"type":"textarea","id":"intro","label":"Introduction","default":"A fabric-led brand creating better Merino Wool essentials for everyday life."}],"presets":[{"name":"About Merino"}]}{% endschema %}
