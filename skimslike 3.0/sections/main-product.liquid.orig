{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'ProductForm-' | append: section.id %}
<section class="product-template page-width" data-product-section>
  <div class="product-media">
    {% if product.media.size > 0 %}
      {% for media in product.media %}
        <div class="product-media__item">
          {% if media.media_type == 'image' %}
            {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', alt: media.alt | default: product.title }}
          {% else %}
            {{ media | media_tag }}
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>
  <div class="product-details">
    <p class="product__vendor">{{ product.vendor | default: product.type }}</p>
    <h1 class="product__title">{{ product.title }}</h1>
    <p class="price" data-product-price>{{ current_variant.price | money }}</p>
    {% if current_variant.compare_at_price > current_variant.price %}<p class="compare-price">{{ current_variant.compare_at_price | money }}</p>{% endif %}
    {% form 'product', product, id: 'ProductForm-' | append: section.id %}
      {% for option in product.options_with_values %}
        <fieldset class="variant-options">
          <legend>{{ option.name }} <span data-selected-option>{{ option.selected_value }}</span></legend>
          <div class="variant-options__values">
            {% for option_value in option.values %}
              <input id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ option_value | escape }}" data-option-position="{{ option.position }}"{% if option_value.selected %} checked{% endif %}{% unless option_value.available %} disabled{% endunless %}>
              <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">{{ option_value }}{% unless option_value.available %}<span>Sold out</span>{% endunless %}</label>
            {% endfor %}
          </div>
        </fieldset>
      {% endfor %}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
      <button class="button button--dark" type="submit"{% unless current_variant.available %} disabled{% endunless %} data-add-to-cart>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</button>
    {% endform %}
    {% if product.description != blank %}<details open><summary>Description</summary><div class="rte">{{ product.description }}</div></details>{% endif %}
    {% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="rte">{{ block.settings.text }}</div></details>{% endfor %}
  </div>
  <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
</section>

{% schema %}
{
  "name": "Main product",
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your policy here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Main product" }]
}
{% endschema %}
