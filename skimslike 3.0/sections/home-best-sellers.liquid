{% assign selected_collection = section.settings.collection %}
<section class="collection-template"><div class="page-width collection-heading"><h1>{{ section.settings.heading }}</h1><p class="collection-subtitle">{{ section.settings.subtitle }}</p><p class="breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {{ section.settings.breadcrumb }}</p></div><div class="filter-row page-width"><span>Sort &nbsp;&nbsp; Gender⌄ &nbsp;&nbsp; Size⌄ &nbsp;&nbsp; Band⌄ &nbsp;&nbsp; Cup⌄ &nbsp;&nbsp; Type⌄ &nbsp;&nbsp; Color⌄ &nbsp;&nbsp; Collection⌄ &nbsp;&nbsp; Material⌄ &nbsp;&nbsp; Sleeve length⌄ &nbsp;&nbsp; Inseam⌄</span><span>{{ selected_collection.products_count | default: 0 }} products</span></div><div class="page-width product-grid">{% if selected_collection != blank %}{% for product in selected_collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}{% else %}{% for i in (1..8) %}<article class="product-card"><div class="product-card__image">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><div class="product-card__info"><p class="eyebrow">Fits Everybody</p><h3>Bodysuit</h3><p>$62</p></div></article>{% endfor %}{% endif %}</div></section>
{% schema %}{"name":"Home best sellers","settings":[{"type":"collection","id":"collection","label":"Best sellers collection"},{"type":"text","id":"heading","label":"Heading","default":"Best sellers"},{"type":"text","id":"subtitle","label":"Subtitle","default":"The must-haves all your friends have been telling you about"},{"type":"text","id":"breadcrumb","label":"Breadcrumb","default":"Best Sellers"},{"type":"range","id":"products_to_show","label":"Products","min":4,"max":16,"step":4,"default":8}],"presets":[{"name":"Home best sellers"}]}{% endschema %}
