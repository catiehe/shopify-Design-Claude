<section class="featured-collection page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2>{% if section.settings.view_more_link != blank %}<a href="{{ section.settings.view_more_link }}">{{ section.settings.view_more_label | default: 'View more' }}</a>{% elsif section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">View more</a>{% endif %}</div><div class="product-grid">{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}{% else %}{% for i in (1..4) %}<article class="product-card">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</article>{% endfor %}{% endif %}</div></section>
{% style %}
  #shopify-section-{{ section.id }} .section-heading h2 {
    font-family: var(--font-body-family);
    font-size: 28px;
    font-weight: 300;
    letter-spacing: .04em;
    text-transform: none;
  }
{% endstyle %}
{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"Best sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":12,"step":1,"default":8},{"type":"text","id":"view_more_label","label":"View more label","default":"View more"},{"type":"url","id":"view_more_link","label":"View more link"}],"presets":[{"name":"Featured collection"}]}{% endschema %}
