<header class="skim-header" data-header>
  {% if section.settings.announcement != blank %}
    <div class="skim-announcement">
      {% if section.settings.announcement_link != blank %}<a href="{{ section.settings.announcement_link }}">{% endif %}
      {{ section.settings.announcement | escape }}
      {% if section.settings.announcement_link != blank %}</a>{% endif %}
    </div>
  {% endif %}
  <div class="skim-header__bar page-pad">
    <button class="skim-header__menu-button" type="button" aria-expanded="false" aria-controls="MobileMenu" data-menu-toggle>{{ 'header.menu' | t }}</button>
    <a class="skim-header__logo" href="{{ routes.root_url }}">{{ section.settings.brand_name | default: shop.name | escape }}</a>
    <nav class="skim-header__nav" aria-label="{{ 'header.main_navigation' | t }}">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">{{ 'header.shop_all' | t }}</a>
      {% endfor %}
    </nav>
    <div class="skim-header__actions">
      <a href="{{ routes.search_url }}">{{ 'header.search' | t }}</a>
      {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'header.account' | t }}</a>{% endif %}
      <a href="{{ routes.cart_url }}" aria-label="{{ 'header.bag_with_count' | t: count: cart.item_count }}">{{ 'header.bag' | t }} <span>({{ cart.item_count }})</span></a>
    </div>
  </div>
  <nav id="MobileMenu" class="skim-header__mobile" aria-label="{{ 'header.mobile_navigation' | t }}" hidden data-mobile-menu>
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
  </nav>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "SKIMSLIKE" },
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "Free shipping on domestic orders $75+" },
    { "type": "url", "id": "announcement_link", "label": "Announcement link" },
    { "type": "link_list", "id": "menu", "label": "t:labels.menu" }
  ]
}
{% endschema %}
