<footer class="mellow-footer full-width">
  <div class="mellow-footer__column"><h2>Help</h2><a href="/pages/contact">Contact us</a><a href="/pages/shipping">Shipping</a><a href="/pages/returns">Returns</a><a href="/pages/size-guide">Size guide</a><a href="/pages/faq">FAQs</a></div>
  <div class="mellow-footer__signup"><h2>Stay in the know</h2><p>New arrivals, special offers, and thoughtfully made essentials — delivered to your inbox.</p>{% form 'customer', class: 'mellow-footer__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="footer-email">Email address</label><input id="footer-email" type="email" name="contact[email]" placeholder="your email" required><button type="submit" aria-label="Subscribe">→</button>{% endform %}<p class="mellow-footer__legal">By subscribing, you agree to receive marketing emails from Mellowool. View <a href="/policies/terms-of-service">Terms</a> & <a href="/policies/privacy-policy">Privacy</a>.</p><div class="mellow-footer__social"><a href="#">Instagram</a><a href="#">Facebook</a><a href="#">TikTok</a></div></div>
  <div class="mellow-footer__column mellow-footer__column--right"><h2>More</h2><a href="/pages/about">About</a><a href="/pages/contact">Stockists</a><a href="/blogs/news">Journal</a><a href="/policies/privacy-policy">Privacy</a><a href="/policies/terms-of-service">Terms</a></div>
</footer>
{% stylesheet %}
  .mellow-footer { background: #fff; color: #302d2b; display: grid; font-family: Arial, Helvetica, sans-serif; grid-template-columns: 1fr 1.35fr 1fr; margin-top: 0; padding: 58px max(28px, 11vw) 35px; text-align: center; }.mellow-footer h2 { font-size: 21px; font-weight: 800; letter-spacing: -.02em; margin-bottom: 18px; text-transform: uppercase; }.mellow-footer__column { display: flex; flex-direction: column; font-size: 16px; gap: 17px; }.mellow-footer a { color: inherit; text-decoration: none; }.mellow-footer__signup { max-width: 570px; justify-self: center; }.mellow-footer__signup > p { font-size: 16px; line-height: 1.35; margin: 0 auto 28px; max-width: 480px; }.mellow-footer__form { display: flex; margin: 0 auto 28px; max-width: 520px; }.mellow-footer__form input { border: 1px solid #34312e; border-radius: 0; flex: 1; font-size: 16px; min-height: 54px; padding: 0 18px; }.mellow-footer__form button { background: #302d2b; border: 1px solid #302d2b; color: #fff; cursor: pointer; font-size: 31px; line-height: 1; width: 66px; }.mellow-footer .mellow-footer__legal { font-size: 12px; line-height: 1.4; margin-bottom: 50px; }.mellow-footer__legal a { text-decoration: underline; }.mellow-footer__social { display: flex; font-size: 11px; font-weight: 700; gap: 24px; justify-content: center; letter-spacing: .09em; text-transform: uppercase; }.visually-hidden { clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; } @media (max-width: 720px) {.mellow-footer { grid-template-columns: 1fr; gap: 56px; padding: 55px 28px 35px; }.mellow-footer__column--right { order: 3; }.mellow-footer__signup { order: 2; }.mellow-footer__column { gap: 13px; }}
{% endstylesheet %}
{% schema %}
{"name":"t:general.footer","settings":[]}
{% endschema %}
