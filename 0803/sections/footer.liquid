<footer class="mellow-footer full-width">
  <div class="mellow-footer__column"><h2>Help</h2><a href="/pages/returns">Return Center</a><a href="/pages/returns">Order &amp; Return Tracking</a><a href="/pages/size-guide">Size Guides</a><a href="/pages/contact">Ordering</a><a href="/pages/shipping">Shipping</a><a href="/pages/faq">FAQs</a><a href="/pages/contact">Contact Us</a></div>
  <div class="mellow-footer__signup"><h2>Stay in the know</h2><p>New arrivals, special offers, and thoughtfully made essentials — delivered to your inbox.</p>{% form 'customer', class: 'mellow-footer__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="footer-email">Email address</label><input id="footer-email" type="email" name="contact[email]" placeholder="your email" required><button type="submit" aria-label="Subscribe">→</button>{% endform %}<p class="mellow-footer__legal">By subscribing, you agree to receive marketing emails from Mellowool. View <a href="/policies/terms-of-service">Terms</a> & <a href="/policies/privacy-policy">Privacy</a>.</p><div class="mellow-footer__social"><a href="#">Instagram</a><a href="#">Facebook</a><a href="#">TikTok</a></div></div>
  <div class="mellow-footer__column mellow-footer__column--right"><h2>More</h2><a href="/pages/about">About</a><a href="/pages/contact">Stockists</a><a href="/blogs/news">Journal</a><a href="/policies/privacy-policy">Privacy</a><a href="/policies/terms-of-service">Terms</a></div>
</footer>
{% stylesheet %}
  .mellow-footer { background: #fff; color: #302d2b; display: grid; font-family: var(--mellow-font-body), Arial, Helvetica, sans-serif; grid-template-columns: 1fr 1.35fr 1fr; margin-top: 0; padding: 58px max(28px, 11vw) 35px; text-align: center; }.mellow-footer h2 { font-family: var(--mellow-font-display), 'Arial Narrow', Arial, sans-serif; font-size: 25px; font-weight: 700; letter-spacing: .045em; line-height: 1; margin-bottom: 21px; text-transform: uppercase; }.mellow-footer__column { display: flex; flex-direction: column; font-size: 14px; font-weight: 400; gap: 14px; letter-spacing: -.012em; line-height: 1.3; }.mellow-footer a { color: #46413e; text-decoration: none; }.mellow-footer__column a { transition: color .2s ease; }.mellow-footer__column a:hover { color: #171514; }.mellow-footer__signup { max-width: 570px; justify-self: center; }.mellow-footer__signup > p { font-size: 15px; line-height: 1.42; margin: 0 auto 28px; max-width: 480px; }.mellow-footer__form { display: flex; margin: 0 auto 28px; max-width: 520px; }.mellow-footer__form input { border: 1px solid #4e4945; border-radius: 0; flex: 1; font-size: 15px; min-height: 54px; padding: 0 18px; }.mellow-footer__form button { background: #302d2b; border: 1px solid #302d2b; color: #fff; cursor: pointer; font-size: 31px; line-height: 1; width: 66px; }.mellow-footer .mellow-footer__legal { color: #5e5854; font-size: 11px; line-height: 1.45; margin-bottom: 50px; }.mellow-footer__legal a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }.mellow-footer__social { display: flex; font-size: 10px; font-weight: 600; gap: 24px; justify-content: center; letter-spacing: .075em; text-transform: uppercase; }.visually-hidden { clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; } @media (max-width: 720px) {.mellow-footer { grid-template-columns: 1fr; gap: 0; padding: 0 28px 35px; text-align: left; }.mellow-footer__column { border-top: 1px solid #e9e6e2; gap: 14px; padding: 25px 0 30px; }.mellow-footer__column--right { border-bottom: 1px solid #e9e6e2; order: 3; }.mellow-footer__signup { border-top: 1px solid #e9e6e2; order: 2; padding: 38px 0 45px; text-align: center; }.mellow-footer__signup > p { font-size: 14px; }.mellow-footer h2 { font-size: 24px; margin-bottom: 18px; }}
{% endstylesheet %}
