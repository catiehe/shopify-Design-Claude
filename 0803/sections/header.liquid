<header class="mellow-header">
  <div class="mellow-header__announcement"><span>{{ section.settings.announcement }}</span><a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_link_text }}</a><span class="mellow-header__currency">USD⌄</span></div>
  <div class="mellow-header__navigation">
    <button class="mellow-header__menu-toggle" type="button" aria-label="Open menu">Menu</button>
    <a class="mellow-header__brand" href="{{ routes.root_url }}">{{ section.settings.brand_name }}</a>
    <nav class="mellow-header__nav" aria-label="Main navigation">{% for link in section.settings.menu.links %}{{ link.title | link_to: link.url }}{% else %}<a href="{{ routes.all_products_collection_url }}">New</a><a href="{{ routes.all_products_collection_url }}">Best Sellers</a><a href="{{ routes.all_products_collection_url }}">Clothing</a><a href="{{ routes.all_products_collection_url }}">Essentials</a><a href="{{ routes.all_products_collection_url }}">Sale</a>{% endfor %}</nav>
    <div class="mellow-header__actions"><a href="{{ routes.search_url }}" aria-label="Search">⌕</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="Account">♙</a>{% endif %}<a href="{{ routes.cart_url }}" aria-label="Bag">Bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a></div>
  </div>
</header>
{% stylesheet %}
  .mellow-header { background: #fff; color: #292625; font-family: Arial, Helvetica, sans-serif; }.mellow-header a { color: inherit; text-decoration: none; }.mellow-header__announcement { align-items: center; border-bottom: 1px solid #eeeeec; display: grid; grid-template-columns: 1fr auto 1fr; font-size: 13px; min-height: 45px; padding: 0 16px; text-align: center; }.mellow-header__announcement a { text-decoration: underline; }.mellow-header__currency { justify-self: end; }.mellow-header__navigation { align-items: center; display: grid; grid-template-columns: auto 1fr auto; min-height: 72px; padding: 0 16px; }.mellow-header__brand { font-size: 25px; font-weight: 900; letter-spacing: -.14em; margin-right: 52px; }.mellow-header__nav { align-items: center; display: flex; gap: 27px; font-size: 17px; font-weight: 700; white-space: nowrap; }.mellow-header__actions { align-items: center; display: flex; font-size: 19px; gap: 20px; justify-content: flex-end; }.mellow-header__actions a:last-child { font-size: 13px; font-weight: 700; text-transform: uppercase; }.mellow-header__menu-toggle { display: none; } @media (max-width: 900px) {.mellow-header__nav { gap: 16px; font-size: 14px; }.mellow-header__brand { margin-right: 28px; }} @media (max-width: 680px) {.mellow-header__announcement { font-size: 11px; grid-template-columns: 1fr auto; }.mellow-header__announcement a { display: none; }.mellow-header__navigation { grid-template-columns: auto 1fr auto; min-height: 58px; }.mellow-header__menu-toggle { background: none; border: 0; display: block; font: inherit; font-size: 11px; font-weight: 700; padding: 0; text-transform: uppercase; }.mellow-header__brand { font-size: 19px; justify-self: center; margin: 0; }.mellow-header__nav { display: none; }.mellow-header__actions { gap: 10px; font-size: 18px; }}
{% endstylesheet %}
{% schema %}
{"name":"t:general.header","settings":[{"type":"text","id":"brand_name","label":"Brand name","default":"MELLOWOOL"},{"type":"text","id":"announcement","label":"Announcement","default":"Free shipping on orders over $75"},{"type":"text","id":"announcement_link_text","label":"Announcement link text","default":"Sign up for email & SMS"},{"type":"url","id":"announcement_link","label":"Announcement link"},{"type":"link_list","id":"menu","label":"t:labels.menu"}]}
{% endschema %}
