<header class="mellow-header">
  <button class="mellow-header__menu-toggle" type="button" aria-label="Menu">Menu</button>
  <nav class="mellow-header__nav" aria-label="Main navigation">{% for link in section.settings.menu.links %}{{ link.title | link_to: link.url }}{% else %}<a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/about">About</a>{% endfor %}</nav>
  <a class="mellow-header__brand" href="{{ routes.root_url }}">{{ shop.name | default: 'MELLOW' }}</a>
  <div class="mellow-header__actions"><a href="{{ routes.search_url }}" aria-label="Search">Search</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="Account">Account</a>{% endif %}<a href="{{ routes.cart_url }}" aria-label="Bag">Bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a></div>
</header>
{% stylesheet %}
  .mellow-header { min-height: 70px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 28px; background: #f7f6f3; color: #1d1b19; border-bottom: 1px solid #e5e1dc; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }.mellow-header a { color: inherit; text-decoration: none; }.mellow-header__nav, .mellow-header__actions { display: flex; gap: 22px; }.mellow-header__brand { font-size: 18px; letter-spacing: .18em; }.mellow-header__actions { justify-content: flex-end; }.mellow-header__menu-toggle { display: none; background: none; border: 0; color: inherit; font: inherit; letter-spacing: inherit; text-transform: inherit; } @media (max-width: 720px) {.mellow-header { grid-template-columns: 1fr auto 1fr; padding: 0 17px; min-height: 60px; }.mellow-header__nav { display: none; }.mellow-header__menu-toggle { display: block; padding: 0; }.mellow-header__actions a:not(:last-child) { display: none; }.mellow-header__brand { font-size: 15px; }.mellow-header__actions { gap: 0; }}
{% endstylesheet %}
{% schema %}
{"name":"t:general.header","settings":[{"type":"link_list","id":"menu","label":"t:labels.menu"}]}
{% endschema %}
