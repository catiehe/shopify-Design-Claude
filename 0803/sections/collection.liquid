<section class="mellow-collection">
  <div class="mellow-collection__header"><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="mellow-collection__description">{{ collection.description }}</div>{% endif %}<p class="mellow-collection__crumb"><a href="{{ routes.root_url }}">Home</a><span>/</span>{{ collection.title }}</p></div>
  <div class="mellow-collection__toolbar"><button type="button">Sort</button><button type="button">Size</button><button type="button">Color</button><button type="button">Collection</button><button type="button">Material</button><button type="button">Style</button><button type="button">Length</button><button type="button">Fit</button></div>
  {% paginate collection.products by 24 %}
    <div class="mellow-collection__grid">
      {% for product in collection.products %}
        <article class="mellow-product-card"><a href="{{ product.url }}" class="mellow-product-card__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<div class="mellow-product-card__placeholder"></div>{% endif %}{% if product.compare_at_price > product.price %}<span class="mellow-product-card__badge">Sale</span>{% endif %}</a><div class="mellow-product-card__info"><a href="{{ product.url }}">{{ product.title }}</a><span>{{ product.price | money }}</span></div>{% if product.options_with_values.size > 0 %}<div class="mellow-product-card__swatches">{% for value in product.options_with_values.first.values limit: 5 %}<span title="{{ value | escape }}"></span>{% endfor %}</div>{% endif %}</article>
      {% else %}<p class="mellow-collection__empty">No pieces in this collection yet.</p>{% endfor %}
    </div>
    {% if paginate.pages > 1 %}<div class="mellow-pagination">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</section>
{% stylesheet %}
  .mellow-collection { background: #fff; color: #302d2b; font-family: Arial, Helvetica, sans-serif; }.mellow-collection__header { border-bottom: 1px solid #ededeb; padding: 32px 16px 30px; }.mellow-collection h1 { font-size: clamp(32px, 3vw, 45px); font-weight: 800; letter-spacing: .02em; line-height: 1; text-transform: uppercase; }.mellow-collection__description { font-size: 17px; line-height: 1.45; margin-top: 17px; max-width: 700px; }.mellow-collection__crumb { display: flex; font-size: 14px; gap: 10px; margin-top: 22px; }.mellow-collection__crumb a { color: inherit; text-decoration: none; }.mellow-collection__toolbar { border-bottom: 1px solid #ededeb; display: flex; gap: 34px; overflow-x: auto; padding: 25px 16px; white-space: nowrap; }.mellow-collection__toolbar button { background: none; border: 0; color: inherit; cursor: pointer; font: 700 16px Arial, Helvetica, sans-serif; padding: 0; text-transform: uppercase; }.mellow-collection__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; }.mellow-product-card { background: #f5f4f2; min-width: 0; }.mellow-product-card__image { aspect-ratio: .74; display: block; overflow: hidden; position: relative; }.mellow-product-card__image img, .mellow-product-card__placeholder { width: 100%; height: 100%; object-fit: cover; }.mellow-product-card__placeholder { background: linear-gradient(135deg, #ddd8d2, #b9afa6); }.mellow-product-card__image img { transition: transform .45s ease; }.mellow-product-card:hover img { transform: scale(1.025); }.mellow-product-card__badge { background: #fff; font-size: 10px; left: 12px; letter-spacing: .1em; padding: 8px 9px; position: absolute; text-transform: uppercase; top: 12px; }.mellow-product-card__info { display: flex; justify-content: space-between; gap: 12px; padding: 15px 15px 8px; font-size: 12px; }.mellow-product-card__info a { color: inherit; text-decoration: none; }.mellow-product-card__info span { color: #68625c; white-space: nowrap; }.mellow-product-card__swatches { display: flex; gap: 5px; padding: 0 15px 19px; }.mellow-product-card__swatches span { background: #8c8176; border: 1px solid #f7f6f3; border-radius: 50%; height: 10px; width: 10px; }.mellow-product-card__swatches span:nth-child(2n) { background: #e4ded6; }.mellow-product-card__swatches span:nth-child(3n) { background: #3b3632; }.mellow-collection__empty { grid-column: 1 / -1; padding: 80px; text-align: center; }.mellow-pagination { padding: 42px; text-align: center; }.mellow-pagination a { color: inherit; margin: 0 5px; } @media (max-width: 720px) {.mellow-collection__header { padding: 28px 16px 24px; }.mellow-collection__toolbar { gap: 23px; padding: 19px 16px; }.mellow-collection__toolbar button { font-size: 13px; }.mellow-collection__grid { grid-template-columns: repeat(2, 1fr); }.mellow-product-card__info { display: block; line-height: 1.5; }.mellow-product-card__info span { display: block; }}
{% endstylesheet %}
{% schema %}
{"name":"t:general.collection","settings":[]}
{% endschema %}
