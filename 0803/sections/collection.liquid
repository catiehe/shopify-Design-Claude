<section class="mellow-collection">
  <div class="mellow-collection__header"><p class="mellow-collection__eyebrow">{{ collection.products_count }} PIECES</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="mellow-collection__description">{{ collection.description }}</div>{% endif %}</div>
  <div class="mellow-collection__toolbar"><span>All styles</span><button type="button">Filter +</button><button type="button">Sort by +</button></div>
  {% paginate collection.products by 24 %}
    <div class="mellow-collection__grid">
      {% for product in collection.products %}
        <article class="mellow-product-card"><a href="{{ product.url }}" class="mellow-product-card__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<div class="mellow-product-card__placeholder"></div>{% endif %}{% if product.compare_at_price > product.price %}<span class="mellow-product-card__badge">Sale</span>{% endif %}</a><div class="mellow-product-card__info"><a href="{{ product.url }}">{{ product.title }}</a><span>{{ product.price | money }}</span></div>{% if product.options_with_values.size > 0 %}<div class="mellow-product-card__swatches">{% for value in product.options_with_values.first.values limit: 5 %}<span title="{{ value | escape }}"></span>{% endfor %}</div>{% endif %}</article>
      {% else %}<p class="mellow-collection__empty">No pieces in this collection yet.</p>{% endfor %}
    </div>
    {% if paginate.pages > 1 %}<div class="mellow-pagination">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</section>
{% stylesheet %}
  .mellow-collection { background: #f7f6f3; color: #1d1b19; }.mellow-collection__header { padding: 72px 28px 52px; text-align: center; }.mellow-collection__eyebrow { font-size: 11px; letter-spacing: .16em; margin-bottom: 16px; }.mellow-collection h1 { font-size: clamp(44px, 6vw, 82px); font-weight: 400; letter-spacing: -.055em; line-height: 1; }.mellow-collection__description { color: #625e59; line-height: 1.55; max-width: 520px; margin: 22px auto 0; }.mellow-collection__toolbar { border-bottom: 1px solid #e5e1dc; border-top: 1px solid #e5e1dc; display: flex; gap: 28px; padding: 15px 28px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }.mellow-collection__toolbar span { margin-right: auto; }.mellow-collection__toolbar button { background: none; border: 0; color: inherit; cursor: pointer; font: inherit; letter-spacing: inherit; text-transform: inherit; }.mellow-collection__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }.mellow-product-card { background: #f0eeea; min-width: 0; }.mellow-product-card__image { aspect-ratio: .74; display: block; overflow: hidden; position: relative; }.mellow-product-card__image img, .mellow-product-card__placeholder { width: 100%; height: 100%; object-fit: cover; }.mellow-product-card__placeholder { background: linear-gradient(135deg, #ddd8d2, #b9afa6); }.mellow-product-card__image img { transition: transform .45s ease; }.mellow-product-card:hover img { transform: scale(1.025); }.mellow-product-card__badge { background: #fff; font-size: 10px; left: 12px; letter-spacing: .1em; padding: 8px 9px; position: absolute; text-transform: uppercase; top: 12px; }.mellow-product-card__info { display: flex; justify-content: space-between; gap: 12px; padding: 15px 15px 8px; font-size: 12px; }.mellow-product-card__info a { color: inherit; text-decoration: none; }.mellow-product-card__info span { color: #68625c; white-space: nowrap; }.mellow-product-card__swatches { display: flex; gap: 5px; padding: 0 15px 19px; }.mellow-product-card__swatches span { background: #8c8176; border: 1px solid #f7f6f3; border-radius: 50%; height: 10px; width: 10px; }.mellow-product-card__swatches span:nth-child(2n) { background: #e4ded6; }.mellow-product-card__swatches span:nth-child(3n) { background: #3b3632; }.mellow-collection__empty { grid-column: 1 / -1; padding: 80px; text-align: center; }.mellow-pagination { padding: 42px; text-align: center; }.mellow-pagination a { color: inherit; margin: 0 5px; } @media (max-width: 720px) {.mellow-collection__header { padding: 54px 20px 38px; }.mellow-collection__toolbar { padding: 14px 17px; gap: 15px; }.mellow-collection__toolbar span { display: none; }.mellow-collection__grid { grid-template-columns: repeat(2, 1fr); }.mellow-product-card__info { display: block; line-height: 1.5; }.mellow-product-card__info span { display: block; }}
{% endstylesheet %}
{% schema %}
{"name":"t:general.collection","settings":[]}
{% endschema %}
