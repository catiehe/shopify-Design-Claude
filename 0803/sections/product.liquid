<section class="mellow-product">
  <div class="mellow-product__media">
    {% for image in product.images %}<div class="mellow-product__image">{{ image | image_url: width: 1500 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}</div>{% else %}<div class="mellow-product__image mellow-product__image--placeholder"></div>{% endfor %}
  </div>
  <div class="mellow-product__summary"><div class="mellow-product__summary-inner"><p class="mellow-product__eyebrow">{{ product.vendor | default: 'MELLOWOOL' }}</p><div class="mellow-product__title-row"><h1>{{ product.title }}</h1><span>{{ product.price | money }}</span></div>{% if product.compare_at_price > product.price %}<p class="mellow-product__sale">{{ product.compare_at_price | money }} regular price</p>{% endif %}<p class="mellow-product__promise">Complimentary returns for Mellowool members.<br><a href="/pages/returns">Explore returns & exchanges</a></p>
    {% form 'product', product %}{% assign current_variant = product.selected_or_first_available_variant %}{% for option in product.options_with_values %}<fieldset class="mellow-product__option"><legend>{{ option.name }} <span>{{ option.selected_value }}</span></legend><div class="mellow-product__values">{% for value in option.values %}<input id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if value.selected %}checked{% endif %}><label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">{{ value }}</label>{% endfor %}</div></fieldset>{% endfor %}<div class="mellow-product__quantity"><label for="quantity">Quantity</label><select id="quantity" name="quantity">{% for item in (1..10) %}<option value="{{ item }}">{{ item }}</option>{% endfor %}</select></div><button class="mellow-product__add" type="submit" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to bag — {{ current_variant.price | money }}{% else %}Sold out{% endif %}</button>{% endform %}
    <div class="mellow-product__description">{{ product.description | default: 'A refined everyday essential, created for a comfortable, confident fit.' }}</div><details><summary>Size & fit <span>+</span></summary><p>Designed for a close, flexible fit. Refer to the size guide for measurements.</p></details><details><summary>Shipping & returns <span>+</span></summary><p>Complimentary standard delivery on qualifying orders. Returns accepted within 30 days.</p></details></div></div>
</section>
<section class="mellow-product__related full-width">
  <div class="mellow-product__related-heading"><h2>Complete the look</h2><span>01 / 01</span></div>
  <div class="mellow-product__related-grid">
    {% assign shown_products = 0 %}{% for item in collections.all.products %}{% unless item.id == product.id %}{% if shown_products < 3 %}<article class="mellow-product__related-card"><a href="{{ item.url }}" class="mellow-product__related-image">{% if item.featured_image %}{{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: item.title }}{% else %}<span></span>{% endif %}</a><div class="mellow-product__related-info"><p>{{ item.vendor | default: 'MELLOWOOL' }}</p><div><a href="{{ item.url }}">{{ item.title }}</a><strong>{{ item.price | money }}</strong></div><label>Color&nbsp;&nbsp;<b>{{ item.options_with_values.first.selected_value | default: 'Natural' }}</b></label><select aria-label="Select size for {{ item.title }}"><option>Select size</option>{% for value in item.options_with_values.last.values %}<option>{{ value }}</option>{% endfor %}</select><button type="button">Add to bag</button></div></article>{% assign shown_products = shown_products | plus: 1 %}{% endif %}{% endunless %}{% endfor %}
  </div>
</section>
<section class="mellow-product__reviews full-width"><h2>Reviews</h2><div class="mellow-product__rating"><strong>4.8 ★★★★★</strong><span>Based on customer reviews</span><div class="mellow-product__fit"><i></i><b></b><i></i><span>Runs small</span><span>True to size</span><span>Runs large</span></div></div><article><p><b>Verified customer</b></p><div><strong>★★★★★</strong><h3>Comfortable, every day.</h3><p>Thoughtfully designed for an effortless fit and feel.</p></div></article></section>
{% stylesheet %}
  .mellow-product { background: #fff; color: #302d2b; display: grid; grid-template-columns: 1fr 1fr; align-items: start; font-family: Arial, Helvetica, sans-serif; }.mellow-product__media { display: grid; grid-template-columns: 1fr; gap: 1px; }.mellow-product__image { aspect-ratio: .78; background: #e5dfd7; overflow: hidden; }.mellow-product__image img { height: 100%; object-fit: cover; width: 100%; }.mellow-product__image--placeholder { background: linear-gradient(140deg, #d8d0c8, #aa9d91); }.mellow-product__summary { position: sticky; top: 0; }.mellow-product__summary-inner { max-width: 780px; padding: 50px 45px; }.mellow-product__eyebrow { border-bottom: 1px solid #302d2b; display: inline-block; font-size: 16px; font-weight: 700; margin-bottom: 28px; padding-bottom: 3px; text-transform: uppercase; }.mellow-product__title-row { display: flex; gap: 22px; justify-content: space-between; }.mellow-product h1 { font-size: clamp(34px, 3.6vw, 54px); font-weight: 800; letter-spacing: .025em; line-height: 1; text-transform: uppercase; }.mellow-product__title-row > span { font-size: 26px; padding-top: 4px; white-space: nowrap; }.mellow-product__sale { color: #7d5f55; font-size: 12px; margin-top: 10px; text-decoration: line-through; }.mellow-product__promise { font-size: 15px; font-weight: 700; line-height: 1.4; margin-top: 52px; }.mellow-product__promise a { color: inherit; text-underline-offset: 4px; }.mellow-product form { margin-top: 48px; }.mellow-product__option { border: 0; margin: 0 0 28px; padding: 0; }.mellow-product__option legend { display: flex; font-size: 16px; justify-content: space-between; margin-bottom: 14px; width: 100%; }.mellow-product__option legend span { color: #625e59; font-weight: 400; }.mellow-product__values { display: flex; flex-wrap: wrap; gap: 8px; }.mellow-product__values input { opacity: 0; position: absolute; }.mellow-product__values label { border: 1px solid #dfdad4; cursor: pointer; min-width: 70px; padding: 15px 13px; text-align: center; }.mellow-product__values input:checked + label { border: 2px solid #302d2b; color: #302d2b; }.mellow-product__quantity { align-items: center; border-bottom: 1px solid #cfc9c2; border-top: 1px solid #cfc9c2; display: flex; font-size: 13px; justify-content: space-between; padding: 15px 0; text-transform: uppercase; }.mellow-product__quantity select { border: 0; background: transparent; }.mellow-product__add { background: #302d2b; border: 1px solid #302d2b; color: #fff; cursor: pointer; font-size: 17px; font-weight: 800; letter-spacing: .07em; margin-top: 14px; padding: 21px; text-transform: uppercase; width: 100%; }.mellow-product__add:disabled { background: #aaa49d; border-color: #aaa49d; }.mellow-product__description { line-height: 1.6; margin: 35px 0; }.mellow-product details { border-top: 1px solid #d6d1cb; font-size: 13px; }.mellow-product details:last-child { border-bottom: 1px solid #d6d1cb; }.mellow-product summary { cursor: pointer; display: flex; font-weight: 700; justify-content: space-between; letter-spacing: .07em; padding: 17px 0; text-transform: uppercase; }.mellow-product details p { color: #625e59; line-height: 1.55; padding-bottom: 18px; }.mellow-product__related { background: #f8f7f5; padding: 72px max(22px, 7vw); }.mellow-product__related-heading { align-items: center; display: flex; justify-content: space-between; margin-bottom: 38px; }.mellow-product__related h2, .mellow-product__reviews h2 { font-size: clamp(27px, 2.6vw, 42px); font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }.mellow-product__related-heading span { font-size: 14px; }.mellow-product__related-grid { display: grid; gap: 28px; grid-template-columns: repeat(3, 1fr); }.mellow-product__related-card { background: #fff; }.mellow-product__related-image { background: #f5f4f2; display: block; aspect-ratio: 1; }.mellow-product__related-image img { height: 100%; object-fit: cover; width: 100%; }.mellow-product__related-info { padding: 22px; }.mellow-product__related-info > p { font-size: 13px; font-weight: 700; margin-bottom: 10px; text-transform: uppercase; }.mellow-product__related-info > div { align-items: start; display: flex; font-size: 20px; font-weight: 800; justify-content: space-between; text-transform: uppercase; }.mellow-product__related-info a { color: inherit; text-decoration: none; }.mellow-product__related-info label { display: block; font-size: 15px; margin: 20px 0; }.mellow-product__related-info select, .mellow-product__related-info button { background: #fff; border: 1px solid #302d2b; border-radius: 0; display: block; font: inherit; height: 48px; margin-top: 12px; padding: 0 14px; width: 100%; }.mellow-product__related-info button { color: #88827d; font-size: 17px; font-weight: 800; text-transform: uppercase; }.mellow-product__reviews { background: #fff; padding: 75px max(22px, 7vw); }.mellow-product__rating { align-items: center; display: grid; gap: 12px 45px; grid-template-columns: auto 1fr; margin: 48px 0 58px; }.mellow-product__rating strong { font-size: 31px; }.mellow-product__rating > span { font-size: 17px; }.mellow-product__fit { display: grid; gap: 8px; grid-column: 2; grid-template-columns: 1fr auto 1fr; position: relative; }.mellow-product__fit::before { background: #dedad7; content: ''; height: 5px; left: 0; position: absolute; right: 0; top: 0; }.mellow-product__fit i, .mellow-product__fit b { background: #91847a; border-radius: 50%; height: 11px; position: relative; width: 11px; z-index: 1; }.mellow-product__fit b { background: #6e5f55; height: 18px; justify-self: center; margin-top: -6px; width: 18px; }.mellow-product__fit i:last-of-type { justify-self: end; }.mellow-product__fit span { font-size: 13px; margin-top: 9px; }.mellow-product__fit span:nth-of-type(2) { text-align: center; }.mellow-product__fit span:last-child { text-align: right; }.mellow-product__reviews article { border-top: 1px solid #dfdad5; display: grid; grid-template-columns: 1fr 2fr; padding: 42px 0; }.mellow-product__reviews article strong { font-size: 24px; }.mellow-product__reviews article h3 { font-size: 25px; margin: 22px 0; text-transform: uppercase; } @media (max-width: 900px) {.mellow-product { display: block; }.mellow-product__summary { position: static; }.mellow-product__summary-inner { max-width: none; padding: 48px 24px 65px; }.mellow-product__related-grid { grid-template-columns: 1fr; }.mellow-product__rating { grid-template-columns: 1fr; }.mellow-product__fit { grid-column: 1; }.mellow-product__reviews article { grid-template-columns: 1fr; gap: 28px; }}
{% endstylesheet %}
{% schema %}
{"name":"t:general.product","settings":[],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
