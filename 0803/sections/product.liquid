<section class="mellow-product">
  <div class="mellow-product__media">
    {% for image in product.images %}<div class="mellow-product__image">{{ image | image_url: width: 1500 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}</div>{% else %}<div class="mellow-product__image mellow-product__image--placeholder"></div>{% endfor %}
  </div>
  <div class="mellow-product__summary"><div class="mellow-product__summary-inner"><p class="mellow-product__eyebrow">{{ product.vendor | default: 'MELLOW' }}</p><div class="mellow-product__title-row"><h1>{{ product.title }}</h1><span>{{ product.price | money }}</span></div>{% if product.compare_at_price > product.price %}<p class="mellow-product__sale">{{ product.compare_at_price | money }} regular price</p>{% endif %}
    {% form 'product', product %}{% assign current_variant = product.selected_or_first_available_variant %}{% for option in product.options_with_values %}<fieldset class="mellow-product__option"><legend>{{ option.name }} <span>{{ option.selected_value }}</span></legend><div class="mellow-product__values">{% for value in option.values %}<input id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if value.selected %}checked{% endif %}><label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">{{ value }}</label>{% endfor %}</div></fieldset>{% endfor %}<div class="mellow-product__quantity"><label for="quantity">Quantity</label><select id="quantity" name="quantity">{% for item in (1..10) %}<option value="{{ item }}">{{ item }}</option>{% endfor %}</select></div><button class="mellow-product__add" type="submit" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to bag — {{ current_variant.price | money }}{% else %}Sold out{% endif %}</button>{% endform %}
    <div class="mellow-product__description">{{ product.description | default: 'A refined everyday essential, created for a comfortable, confident fit.' }}</div><details><summary>Size & fit <span>+</span></summary><p>Designed for a close, flexible fit. Refer to the size guide for measurements.</p></details><details><summary>Shipping & returns <span>+</span></summary><p>Complimentary standard delivery on qualifying orders. Returns accepted within 30 days.</p></details></div></div>
</section>
{% stylesheet %}
  .mellow-product { background: #f7f6f3; color: #1d1b19; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(360px, .8fr); align-items: start; }.mellow-product__media { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; }.mellow-product__image { aspect-ratio: .73; background: #e5dfd7; overflow: hidden; }.mellow-product__image img { height: 100%; object-fit: cover; width: 100%; }.mellow-product__image--placeholder { background: linear-gradient(140deg, #d8d0c8, #aa9d91); }.mellow-product__summary { position: sticky; top: 0; }.mellow-product__summary-inner { max-width: 510px; padding: 72px clamp(28px, 6vw, 94px); }.mellow-product__eyebrow { font-size: 11px; letter-spacing: .16em; margin-bottom: 16px; }.mellow-product__title-row { display: flex; gap: 22px; justify-content: space-between; }.mellow-product h1 { font-size: clamp(34px, 3.6vw, 55px); font-weight: 400; letter-spacing: -.05em; line-height: 1; }.mellow-product__title-row > span { font-size: 14px; padding-top: 4px; white-space: nowrap; }.mellow-product__sale { color: #7d5f55; font-size: 12px; margin-top: 10px; text-decoration: line-through; }.mellow-product form { margin-top: 44px; }.mellow-product__option { border: 0; margin: 0 0 26px; padding: 0; }.mellow-product__option legend { display: flex; font-size: 11px; justify-content: space-between; letter-spacing: .1em; margin-bottom: 12px; text-transform: uppercase; width: 100%; }.mellow-product__option legend span { color: #625e59; font-weight: 400; text-transform: none; }.mellow-product__values { display: flex; flex-wrap: wrap; gap: 8px; }.mellow-product__values input { opacity: 0; position: absolute; }.mellow-product__values label { border: 1px solid #cfc9c2; cursor: pointer; min-width: 45px; padding: 12px 13px; text-align: center; }.mellow-product__values input:checked + label { background: #1d1b19; border-color: #1d1b19; color: white; }.mellow-product__quantity { align-items: center; border-bottom: 1px solid #cfc9c2; border-top: 1px solid #cfc9c2; display: flex; font-size: 11px; justify-content: space-between; letter-spacing: .1em; padding: 15px 0; text-transform: uppercase; }.mellow-product__quantity select { border: 0; background: transparent; }.mellow-product__add { background: #1d1b19; border: 1px solid #1d1b19; color: #fff; cursor: pointer; font-size: 11px; letter-spacing: .11em; margin-top: 14px; padding: 18px; text-transform: uppercase; width: 100%; }.mellow-product__add:disabled { background: #aaa49d; border-color: #aaa49d; }.mellow-product__description { line-height: 1.6; margin: 35px 0; }.mellow-product details { border-top: 1px solid #d6d1cb; font-size: 13px; }.mellow-product details:last-child { border-bottom: 1px solid #d6d1cb; }.mellow-product summary { cursor: pointer; display: flex; justify-content: space-between; letter-spacing: .07em; padding: 17px 0; text-transform: uppercase; }.mellow-product details p { color: #625e59; line-height: 1.55; padding-bottom: 18px; } @media (max-width: 900px) {.mellow-product { display: block; }.mellow-product__summary { position: static; }.mellow-product__summary-inner { max-width: none; padding: 48px 24px 65px; }} @media (max-width: 480px) {.mellow-product__media { grid-template-columns: 1fr; }.mellow-product__media .mellow-product__image:nth-child(n+3) { display: none; }}
{% endstylesheet %}
{% schema %}
{"name":"t:general.product","settings":[],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
